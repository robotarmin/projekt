# A kód mesterséges intelligencia segítségével készült. Ezt az egyetemi szabályzatnak megfelelően itt jelölöm. [AI1]
# PTP grandmaster (AES67) a teszt-adon; a kernel TAI-UTC kulonbseget is beallitja
# (a PipeWire clock.id = "tai" ehhez kell).
#   sudo install -m755 tai_offset /usr/local/bin/
#   sudo install -m644 'kuldo/ptp4l-aes67@.service' /etc/systemd/system/
#   sudo systemctl enable --now ptp4l-aes67@<interfesz>
# A ptp4l helye: command -v ptp4l (Arch: /usr/bin, Debian: /usr/sbin).

[Unit]
Description=PTP grandmaster (AES67), %i
BindsTo=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device network-online.target
Wants=network-online.target

[Service]
ExecStartPre=/usr/local/bin/tai_offset 37
ExecStart=/usr/bin/ptp4l -f /etc/linuxptp/aes67-gm.cfg -i %i -m -q
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target sys-subsystem-net-devices-%i.device
