# A kód mesterséges intelligencia segítségével készült. Ezt az egyetemi szabályzatnak megfelelően itt jelölöm. [AI1]
# AES67 vevo.
#   sudo install -m644 vevo/aes67rx.service /etc/systemd/system/
#   sudo systemctl enable --now aes67rx
# Atirando: az eleresi ut, az interfesz, az eszkoz (-d) es a stream neve.
# Szoftveres PTP-nel a ptp4l allitja a rendszerorat: sudo timedatectl set-ntp false

[Unit]
Description=AES67 vevo
Wants=network-online.target
After=network-online.target sound.target

[Service]
ExecStart=/home/aes67/projekt/aes67rx -i eth0 "sap:Laptop AES67"
# I2S HifiBerry DAC, 64x2 keretes ALSA-puffer (2.67 ms). Beepitett jacknel:
#   AES67_ALSA_DEVICE=plughw:Headphones,0, AES67_ALSA_PERIOD=480, AES67_ALSA_PERIODS=3
Environment=AES67_ALSA_DEVICE=plughw:sndrpihifiberry,0
Environment=AES67_ALSA_PERIOD=64
Environment=AES67_ALSA_PERIODS=2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
